# ==============================================================================
# Hotel Reservation System - Environment Configuration Example
# Copy this file to .env or configure your system environment variables.
# ==============================================================================

# MongoDB Connection String
# Local MongoDB Community Server default:
MONGODB_URI=mongodb://localhost:27017

# For MongoDB Atlas (cloud cluster), use your connection URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority

# MongoDB Database Name
MONGODB_DATABASE=hotel_reservation_db

# Initial Admin Bootstrap Account Credentials
# (Auto-seeded safely on startup if the database does not contain an ADMIN user)
ADMIN_BOOTSTRAP_EMAIL=admin@hotelreservation.com
ADMIN_BOOTSTRAP_PASSWORD=Admin@12345
ADMIN_BOOTSTRAP_NAME=Hotel General Manager
ADMIN_BOOTSTRAP_PHONE=+1-555-019-9000

# Application Session Timeout (in minutes)
SESSION_TIMEOUT_MINUTES=30

# Hotel Tax Rate (Percentage, e.g., 12 for 12% sales/hospitality tax)
HOTEL_TAX_PERCENTAGE=12.0

